datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  plan          String   @default("free") // free, starter, professional, agency
  aiCreditLimit Int      @default(500)
  aiCreditUsed  Int      @default(0)
  supportNotes  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users        User[]
  sites        Site[]
  pages        Page[]
  apiKeys      ApiKey[]
  quotaUsages  QuotaUsage[]
  snapshots    ScoreSnapshot[]
  integrations Integration[]
  webhooks     Webhook[]
  auditLogs    AuditLog[]
  creditLedger CreditLedgerEntry[]
}

model User {
  id            String    @id @default(uuid())
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String    @unique
  emailVerified DateTime?
  name          String
  passwordHash  String?
  image         String?
  role          String    @default("editor") // super_admin, admin, editor, viewer
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Site {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  domain        String
  platform      String   @default("custom") // wordpress, nextjs, shopify, go, custom
  defaultLocale String   @default("en-US")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pages        Page[]
  apiKeys      ApiKey[]
  snapshots    ScoreSnapshot[]
  integrations Integration[]
  webhooks     Webhook[]

  @@unique([tenantId, domain])
  @@index([tenantId])
}

model Page {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId        String
  site          Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url           String
  normalizedUrl String
  pageType      String    @default("generic") // homepage, article, product, category, landing, documentation, local_business, generic
  targetKeyword String?
  locale        String
  lastScoredAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  snapshots ScoreSnapshot[]

  @@unique([siteId, normalizedUrl])
  @@index([tenantId])
  @@index([siteId])
}

model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId     String?
  site       Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  name       String
  keyHash    String    @unique
  keyPrefix  String
  scopes     String[]
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([keyHash])
}

model QuotaUsage {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId       String?
  endpoint     String
  featureKey   String?
  provider     String?
  providerCost Int      @default(0)
  units        Int      @default(1)
  cached       Boolean  @default(false)
  date         DateTime // Format: YYYY-MM-DD
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([featureKey])
}

/**
 * Global credit markup — default ×10 on provider cost
 */
model CreditPricingGlobal {
  id                      Int      @id @default(1)
  defaultMarkupMultiplier Float    @default(10)
  updatedAt               DateTime @updatedAt
}

/**
 * Per-feature sell price (super admin managed)
 */
model CreditFeaturePricing {
  id                  String   @id @default(uuid())
  featureKey          String   @unique
  label               String
  category            String // execution | intelligence
  provider            String // internal | vebapi | domaindetailer | similarweb | neuronwriter
  providerCostCredits Int      @default(0)
  sellCredits         Int      @default(1)
  useAutoMarkup       Boolean  @default(true)
  enabled             Boolean  @default(true)
  description         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([category])
  @@index([provider])
}

model CreditLedgerEntry {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureKey   String
  provider     String?
  providerCost Int      @default(0)
  sellCredits  Int
  cached       Boolean  @default(false)
  siteId       String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([featureKey])
}

model ScoreSnapshot {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId        String
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pageId        String?
  page          Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
  url           String
  normalizedUrl String
  scoreVersion  String   @default("seosuite-score-v1.1")
  finalScore    Int
  scoreBand     String // excellent, good, needs_improvement, poor, critical
  pageType      String
  locale        String
  platform      String
  source        String // live_url, draft_content
  durationMs    Int
  createdAt     DateTime @default(now())

  moduleResults       ScoreModuleResult[]
  auditIssues         AuditIssue[]
  recommendations     Recommendation[]
  providerEnrichments ProviderEnrichment[]
  linkOpportunities   InternalLinkOpportunity[]
  aiVisibilityCheck   AiVisibilityCheck?

  @@index([tenantId])
  @@index([siteId])
  @@index([pageId])
}

model ScoreModuleResult {
  id              String        @id @default(uuid())
  tenantId        String
  scoreSnapshotId String
  scoreSnapshot   ScoreSnapshot @relation(fields: [scoreSnapshotId], references: [id], onDelete: Cascade)
  moduleKey       String
  label           String
  score           Int
  maxScore        Int
  status          String
  createdAt       DateTime      @default(now())

  @@index([tenantId])
  @@index([scoreSnapshotId])
}

model AuditIssue {
  id                 String        @id @default(uuid())
  tenantId           String
  scoreSnapshotId    String
  scoreSnapshot      ScoreSnapshot @relation(fields: [scoreSnapshotId], references: [id], onDelete: Cascade)
  code               String
  severity           String // critical, high, medium, low, info, experimental
  module             String
  title              String
  impact             String
  evidenceJson       Json
  recommendation     String
  implementationHint String?
  confidence         Float
  createdAt          DateTime      @default(now())

  @@index([tenantId])
  @@index([scoreSnapshotId])
}

model Recommendation {
  id                 String        @id @default(uuid())
  tenantId           String
  scoreSnapshotId    String
  scoreSnapshot      ScoreSnapshot @relation(fields: [scoreSnapshotId], references: [id], onDelete: Cascade)
  code               String
  title              String
  module             String
  severity           String
  recommendation     String
  implementationHint String?
  estimatedEffort    String // low, medium, high
  estimatedImpact    String // low, medium, high
  confidence         Float
  createdAt          DateTime      @default(now())

  @@index([tenantId])
  @@index([scoreSnapshotId])
}

model Integration {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId         String?
  site           Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  provider       String // neuronwriter, google_search_console, pagespeed
  status         String   @default("active")
  encryptedCreds String
  configJson     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@index([siteId])
}

model ProviderEnrichment {
  id                 String        @id @default(uuid())
  tenantId           String
  scoreSnapshotId    String
  scoreSnapshot      ScoreSnapshot @relation(fields: [scoreSnapshotId], references: [id], onDelete: Cascade)
  provider           String // neuronwriter, etc.
  status             String // success, failed
  requestMetaJson    Json?
  responseMetaJson   Json?
  normalizedDataJson Json?
  durationMs         Int
  createdAt          DateTime      @default(now())

  @@index([tenantId])
  @@index([scoreSnapshotId])
}

model InternalLinkOpportunity {
  id               String        @id @default(uuid())
  tenantId         String
  scoreSnapshotId  String
  scoreSnapshot    ScoreSnapshot @relation(fields: [scoreSnapshotId], references: [id], onDelete: Cascade)
  targetUrl        String
  anchorSuggestion String
  reason           String
  relationship     String
  confidence       Float
  createdAt        DateTime      @default(now())

  @@index([tenantId])
  @@index([scoreSnapshotId])
}

model AiVisibilityCheck {
  id                         String        @id @default(uuid())
  tenantId                   String
  scoreSnapshotId            String        @unique
  scoreSnapshot              ScoreSnapshot @relation(fields: [scoreSnapshotId], references: [id], onDelete: Cascade)
  aiVisibilityReadinessScore Int
  answerability              Float
  citationReadiness          Float
  entityClarity              Float
  aiParseability             Float
  brandTrustSignals          Float
  platformReadinessJson      Json // ChatGPT, Perplexity, Google AIO, Bing Copilot readiness ratings
  createdAt                  DateTime      @default(now())

  @@index([tenantId])
}

model Webhook {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url       String
  events    String[] // score.completed, score.failed, site.crawl.completed, quota.warning
  secret    String? // HMAC signature secret
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@index([siteId])
}

model WebhookDelivery {
  id           String    @id @default(uuid())
  webhookId    String
  webhook      Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  payload      Json
  status       String // pending, delivered, failed
  statusCode   Int?
  responseBody String?
  createdAt    DateTime  @default(now())
  deliveredAt  DateTime?

  @@index([webhookId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId   String? // User id or API key id
  actorType String // user, api_key
  action    String // tenant.plan_updated, tenant.quota_synced, site.crawl_queued, etc.
  resource  String? // affected resource id
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([actorId])
  @@index([createdAt])
}
