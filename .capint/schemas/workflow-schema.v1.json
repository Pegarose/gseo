{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://capint.dev/schemas/workflow-schema.v1.json",
  "title": "CapInt Workflow Definition v1",
  "type": "object",
  "required": ["id", "version", "human_summary", "phases"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "human_summary": { "type": "string", "minLength": 10, "maxLength": 255 },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/phase" }
    }
  },
  "definitions": {
    "phase": {
      "type": "object",
      "required": ["id", "name", "skills", "outputs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string" },
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "requires": {
          "type": "array",
          "items": { "type": "string" }
        },
        "parallel": { "type": "boolean" },
        "gate": { "$ref": "#/definitions/gate" },
        "branches": {
          "type": "array",
          "items": { "$ref": "#/definitions/branch" }
        },
        "loop": { "$ref": "#/definitions/loop" },
        "outputs": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["object"] },
            "properties": { "type": "object" },
            "required": { "type": "array", "items": { "type": "string" } },
            "additionalProperties": { "type": "boolean" }
          },
          "required": ["type", "properties", "required", "additionalProperties"]
        }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["condition"],
      "properties": {
        "condition": { "type": "string", "minLength": 1 },
        "on_fail": {
          "type": "string",
          "enum": ["skip", "fail"],
          "default": "fail"
        }
      },
      "additionalProperties": false
    },
    "branch": {
      "type": "object",
      "required": ["condition", "next"],
      "properties": {
        "condition": { "type": "string", "minLength": 1 },
        "next": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
      },
      "additionalProperties": false
    },
    "loop": {
      "type": "object",
      "required": ["max_iterations"],
      "properties": {
        "max_iterations": { "type": "integer", "minimum": 1, "maximum": 100 },
        "exit_when": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
